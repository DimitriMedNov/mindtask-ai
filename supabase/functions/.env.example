# ---------------------------------------------------------------------------
# Proveedor de IA. Elige uno; el resto de la app funciona aunque no configures
# ninguno (las funciones de IA responden "no configurado" en vez de tronar).
# ---------------------------------------------------------------------------

# --- Opción A: modelo local con Ollama (nada sale de tu máquina) ---
AI_PROVIDER="ollama"
AI_BASE_URL="http://host.docker.internal:11434/v1"   # usa http://localhost:11434/v1 fuera de Docker
AI_MODEL="llama3.2"

# --- Opción B: OpenAI (incluye dictado por voz) ---
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"
# AI_STT_MODEL="whisper-1"

# --- Opción C: Anthropic ---
# AI_PROVIDER="anthropic"
# AI_API_KEY="sk-ant-..."
# AI_MODEL="claude-opus-5"

# --- Opción D: cualquier servidor compatible con la API de OpenAI ---
# AI_PROVIDER="custom"
# AI_BASE_URL="https://tu-servidor/v1"
# AI_API_KEY="..."
# AI_MODEL="el-modelo-que-sea"
