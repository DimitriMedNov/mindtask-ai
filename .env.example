# ---------------------------------------------------------------------------
# Proveedor de IA. Todo es opcional: sin nada configurado la app funciona y solo
# se apagan las funciones de IA.
# ---------------------------------------------------------------------------

# --- Opción A: modelo local con Ollama (nada sale de tu máquina) ---
VITE_AI_PROVIDER="ollama"
VITE_AI_BASE_URL="http://localhost:11434/v1"
VITE_AI_MODEL="llama3.2"

# --- Opción B: OpenAI ---
# VITE_AI_PROVIDER="openai"
# VITE_AI_API_KEY="sk-..."
# VITE_AI_MODEL="gpt-4o-mini"
# VITE_AI_STT_MODEL="whisper-1"

# --- Opción C: Anthropic (solo texto) ---
# VITE_AI_PROVIDER="anthropic"
# VITE_AI_API_KEY="sk-ant-..."
# VITE_AI_MODEL="claude-opus-5"

# --- Dictado en local con whisper.cpp ---
# brew install whisper-cpp
# whisper-server -m ~/.whisper-models/ggml-base.bin --port 8178 -l es
VITE_AI_STT_BASE_URL="http://localhost:8178"
VITE_AI_STT_FORMAT="whisper-cpp"
